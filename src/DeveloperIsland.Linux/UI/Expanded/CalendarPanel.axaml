<!-- Calendar: the next event large, then today's agenda (at most five rows). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveloperIsland.ViewModels"
             xmlns:local="using:DeveloperIsland.UI.Expanded"
             x:Class="DeveloperIsland.UI.Expanded.CalendarPanel"
             x:DataType="vm:CalendarViewModel">
    <Panel>
        <local:ModuleStateView IsVisible="{Binding ShowState}" />

        <StackPanel IsVisible="{Binding IsReady}">
            <TextBlock Classes="caption" Text="Next" FontWeight="SemiBold" />
            <TextBlock Classes="title" Text="{Binding NextTitle}" FontSize="17" Margin="0,6,0,0" />
            <TextBlock Classes="caption" Text="{Binding NextLine}" Margin="0,3,0,0" />

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,14,0,10" />

            <TextBlock Classes="fine" Text="{Binding TodayHeader}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Today}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgendaRow">
                        <Grid Height="28" ColumnDefinitions="62,*" ColumnSpacing="8" Opacity="{Binding RowOpacity}">
                            <TextBlock Classes="caption" Text="{Binding Time}" VerticalAlignment="Center" IsVisible="{Binding IsNotNow}" />
                            <TextBlock Classes="caption" Text="{Binding Time}" VerticalAlignment="Center" IsVisible="{Binding IsNow}"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="caption" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="200" />
                                <TextBlock Classes="fine" Text="{Binding Detail}" MaxWidth="90" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="fine" Text="{Binding MoreText}" Margin="0,4,0,0" IsVisible="{Binding HasMore}" />
            <TextBlock Classes="fine" Text="{Binding FailedText}" Margin="0,8,0,0" IsVisible="{Binding HasFailed}" />
        </StackPanel>
    </Panel>
</UserControl>
