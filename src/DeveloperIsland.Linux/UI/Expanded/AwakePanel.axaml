<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveloperIsland.ViewModels"
             xmlns:c="using:DeveloperIsland.UI.Components"
             x:Class="DeveloperIsland.UI.Expanded.AwakePanel"
             x:DataType="vm:AwakeViewModel">
    <Panel>
        <!-- Idle: presets -->
        <StackPanel IsVisible="{Binding IsIdle}">
            <TextBlock Classes="title" Text="Stay awake" />
            <TextBlock Classes="caption wrap" Margin="0,2,0,0"
                       Text="Keeps this PC awake, also with the lid closed, so Claude Code and other agents keep working." />
            <TextBlock Classes="fine" Text="{Binding SafetyText}" Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,16,0,2" IsVisible="{Binding IsPresetRowVisible}">
                <Button Name="Preset1" Theme="{StaticResource IslandPillButton}" MinWidth="56" Content="1 h" Tag="60" Click="OnPreset" />
                <Button Theme="{StaticResource IslandPillButton}" MinWidth="56" Content="4 h" Tag="240" Click="OnPreset" />
                <Button Theme="{StaticResource IslandPillButton}" MinWidth="56" Content="8 h" Tag="480" Click="OnPreset" />
                <Button Theme="{StaticResource IslandPillButton}" Content="Custom…" Click="OnOpenCustom" />
                <Button Theme="{StaticResource IslandPillButton}" Content="∞ Always" Click="OnIndefinite" ToolTip.Tip="Until you end it" />
            </StackPanel>

            <Grid Margin="0,16,0,2" ColumnDefinitions="Auto,84,Auto,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsCustomRowVisible}">
                <Button Name="MinusButton" Theme="{StaticResource IslandIconButton}" Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource SurfaceRaisedBrush}" Tag="-30" Click="OnAdjust" ToolTip.Tip="30 minutes less">
                    <c:GlyphIcon Glyph="&#xE738;" Size="12" />
                </Button>
                <TextBlock Classes="label" Grid.Column="1" Text="{Binding CustomMinutesText}" HorizontalAlignment="Center" />
                <Button Grid.Column="2" Theme="{StaticResource IslandIconButton}" Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource SurfaceRaisedBrush}" Tag="30" Click="OnAdjust" ToolTip.Tip="30 minutes more">
                    <c:GlyphIcon Glyph="&#xE710;" Size="12" />
                </Button>
                <Button Grid.Column="4" Theme="{StaticResource IslandPillButton}" Content="Cancel" Click="OnCloseCustom" />
                <Button Grid.Column="5" Theme="{StaticResource IslandAccentPillButton}" Content="Start" Click="OnStartCustom" />
            </Grid>
        </StackPanel>

        <!-- Running -->
        <StackPanel IsVisible="{Binding IsActive}">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="caption" Text="Awake" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding StatusText}" />
            </StackPanel>

            <TextBlock Classes="hero tnum" Text="{Binding RemainingText}" Margin="0,4,0,0" />
            <c:Meter Fraction="{Binding Progress}" Margin="0,10,0,0" IsVisible="{Binding IsTimed}" />

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                <c:GlyphIcon Glyph="&#xE7BA;" Size="12" Foreground="{StaticResource WarningBrush}" IsVisible="{Binding LidFailed}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Classes="caption wrap" Text="{Binding LidText}" MaxWidth="360" />
            </StackPanel>
            <TextBlock Classes="fine" Text="{Binding SafetyText}" Margin="0,2,0,0" />

            <Grid Margin="0,16,0,2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Theme="{StaticResource IslandPillButton}" Content="+1 h" Click="OnExtend" IsVisible="{Binding IsTimed}" ToolTip.Tip="One hour more" />
                    <Button Theme="{StaticResource IslandPillButton}" Content="End" Click="OnStop" ToolTip.Tip="End and allow sleep again" />
                </StackPanel>
                <TextBlock Classes="fine" Text="{Binding DetailText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Panel>
</UserControl>
