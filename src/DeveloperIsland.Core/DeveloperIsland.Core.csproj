<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeveloperIsland.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeveloperIsland.Tests" />
  </ItemGroup>

  <!-- The release signing public key (docs/RELEASING.md). Without it the app refuses every update install. -->
  <ItemGroup Condition="Exists('Updates\release-signing-public-key.pem')">
    <EmbeddedResource Include="Updates\release-signing-public-key.pem" LogicalName="release-signing-public-key.pem" />
  </ItemGroup>

</Project>
